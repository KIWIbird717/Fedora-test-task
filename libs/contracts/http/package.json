{
  "name": "@fedora-meetings/contracts-http",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "nx": {
    "name": "contracts-http",
    "tags": [
      "scope:shared",
      "type:contracts"
    ],
    "targets": {
      "generate": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": ["{projectRoot}/src/openapi.yaml"],
        "outputs": ["{workspaceRoot}/apps/web/src/shared/api/schema.d.ts"],
        "options": {
          "command": "pnpm exec openapi-typescript src/openapi.yaml -o ../../../apps/web/src/shared/api/schema.d.ts",
          "cwd": "{projectRoot}"
        }
      }
    }
  },
  "devDependencies": {
    "openapi-typescript": "^7.9.1"
  }
}

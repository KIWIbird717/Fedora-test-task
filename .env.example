NODE_ENV=development

# API bind address and port
API_HOST=0.0.0.0
API_PORT=3000

# Published web port for Docker Compose (not used by Vite)
WEB_PORT=8080

# Maximum concurrent occupied rooms. Integer >= 1.
ROOM_CEILING=50

# Comma-separated STUN URLs sent to clients in the room:join ack. No TURN.
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# Comma-separated browser origins allowed to call the API in local Vite dev.
# Docker same-origin traffic does not need a wide list.
CORS_ORIGINS=http://localhost:5173

# Nest log verbosity: debug | info | warn | error
LOG_LEVEL=info
